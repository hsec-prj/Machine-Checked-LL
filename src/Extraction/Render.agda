------------------------------------------------------------------------
--  Provide certified .bench rendering for extraction (E1, D1-A item 1).
--  renderNet converts flat Extraction.Netlist gates into the ISCAS .bench
--  accepted by ABC and SAT tools and shipped by certified locked artifacts;
--  see Extraction.LockHost.lockHostBench. Its characters come from
--  BenchISCAS.renderNetL, whose printing/parsing and semantic round trips
--  are proved by renderNet-roundtrip and renderNet-sem.
--  Use one line per gate, w<id> names for input
--  and gate-output wires, and ABC-readable vdd()/gnd() constants. These
--  pure String functions introduce no postulates.
------------------------------------------------------------------------

{-# OPTIONS --safe --without-K #-}

module Extraction.Render where

open import Data.Nat using (ℕ)
open import Data.Bool using (Bool; true; false)
open import Data.String using (String; fromList)
open import Data.List using (List) renaming ([] to []ᴸ; _∷_ to _∷ᴸ_)
open import Data.Product using (_,_)
open import Relation.Binary.PropositionalEquality using (_≡_; refl)

open import Extraction.Netlist
  using (Op; oConst; oNot; oAnd; oOr; oXor; popcountEqNet)
open import Extraction.BenchISCAS using (renderNetL)

------------------------------------------------------------------------
--  Render flat netlists as .bench, one gate per line with w<id> wire names.
--  The characters are BenchISCAS.renderNetL output, certified by
--  renderNet-roundtrip to parse back to the original netlist.
--  renderNet is fromList of the certified characters: under --safe, String
--  laws expose toList/fromList injectivity but no toList ∘ fromList ≡ id,
--  so this construction is needed to certify a String-valued printer.

--  Supply the primary-input count n, gate sequence, and output-wire identifier.
renderNet : (n : ℕ) → List Op → ℕ → String
renderNet n ops outId = fromList (renderNetL n ops outId)

--  Check a literal sample of shipped output covering every gate kind and
--  one- and two-digit wire identifiers. Switching to renderNetL must preserve
--  bytes consumed by measurements and CI emit-parity checks. String exposes
--  no general append/show equations under --safe, but primitives compute on
--  closed arguments, allowing this exact sample to be verified by refl.
renderNet-sample :
  renderNet 2 (oAnd 0 1 ∷ᴸ oNot 2 ∷ᴸ oXor 3 0 ∷ᴸ oConst true ∷ᴸ
               oConst false ∷ᴸ oOr 5 6 ∷ᴸ oNot 11 ∷ᴸ []ᴸ) 8
    ≡ "# generated by Extraction.Render (netlist .bench)\nINPUT(w0)\nINPUT(w1)\nOUTPUT(w8)\nw2 = AND(w0, w1)\nw3 = NOT(w2)\nw4 = XOR(w3, w0)\nw5 = vdd()\nw6 = gnd()\nw7 = OR(w5, w6)\nw8 = NOT(w11)"
renderNet-sample = refl

--  Render the efficient popcount-equality netlist, item 2, in .bench format.
renderPopcount : (N h : ℕ) → String
renderPopcount N h = let (ops , outId) = popcountEqNet N h in renderNet N ops outId
