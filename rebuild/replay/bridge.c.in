#include <stdint.h>
#include <inttypes.h>
#include <stdio.h>

typedef uint64_t V __attribute__((vector_size(32)));
static V broadcast(uint64_t v) { return (V){v,v,v,v}; }
static uint64_t pc(V x) {
    return __builtin_popcountll(x[0]) + __builtin_popcountll(x[1])
         + __builtin_popcountll(x[2]) + __builtin_popcountll(x[3]);
}

/* FUNCTION DEFINITIONS */

int main(void) {
    const uint64_t all = UINT64_MAX;
    V x[32], arith, adjacent;
    uint64_t mismatch[6] = {0}, samples = 0;
    for (unsigned i = 0; i < 8; ++i) {
        V value = {0,0,0,0};
        for (unsigned a = 0; a < 256; ++a) {
            value[a / 64] |= (uint64_t)((a >> i) & 1) << (a % 64);
        }
        x[i] = value;
    }
    for (unsigned b = 0; b < 65536; ++b) {
        for (unsigned bit = 0; bit < 16; ++bit)
            x[16 + bit] = broadcast((b >> bit) & 1 ? all : 0);
        for (unsigned base = 0; base < 65536; base += 256) {
            for (unsigned bit = 8; bit < 16; ++bit)
                x[bit] = broadcast((base >> bit) & 1 ? all : 0);
            for (unsigned lane = 0; lane < 4; ++lane) {
                uint64_t positive = 0, negative = 0;
                for (unsigned bit = 0; bit < 64; ++bit) {
                    uint32_t product = (uint32_t)(base + 64*lane + bit) * b;
                    positive |= (uint64_t)((product >> 15) & 1) << bit;
                    negative |= (uint64_t)((product >> 14) & 1) << bit;
                }
                arith[lane] = positive;
                adjacent[lane] = negative;
            }
            V l = lut_cone(x), g = golden_cone(x), n = norm_cone(x);
            mismatch[0] += pc(l ^ arith);
            mismatch[1] += pc(g ^ arith);
            mismatch[2] += pc(l ^ g);
            mismatch[3] += pc(n ^ arith);
            mismatch[4] += pc(l ^ adjacent);
            mismatch[5] += pc((~l) ^ arith);
            samples += 256;
        }
        if (b % 8192 == 8191) {
            fprintf(stderr, "operand B range completed through %u\n", b);
            fflush(stderr);
        }
    }
    printf("{\"vectors\":%"PRIu64",\"cone_vs_intprod\":%"PRIu64",\"golden_vs_intprod\":%"PRIu64","
           "\"mismatches\":%"PRIu64",\"norm_vs_intprod\":%"PRIu64",\"intprod_neg_mismatches\":%"PRIu64","
           "\"inverted_output_mismatches\":%"PRIu64"}\n",
           samples,mismatch[0],mismatch[1],mismatch[2],mismatch[3],mismatch[4],mismatch[5]);
    return 0;
}
